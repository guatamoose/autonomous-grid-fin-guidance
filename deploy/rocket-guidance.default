# Initial installation observes the complete guidance calculation but holds fins neutral.
GUIDANCE_MAX_OFFSET=400
GUIDANCE_MODE_ARG=--observe-only
GUIDANCE_TARGET_FPS=15
GUIDANCE_EXPOSURE_VALUE=-1.0
GUIDANCE_RECORDING=1
